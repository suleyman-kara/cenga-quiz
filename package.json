{
  "name": "club-live-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:emu": "firebase emulators:exec --project demo-club-quiz --only auth,firestore,database,functions \"vitest run --project emulator\"",
    "test": "npm run test:unit && npm run build:functions && npm run test:emu",
    "build:functions": "npm --prefix functions run build",
    "emulators": "firebase emulators:start --project demo-club-quiz --import .emulator-data --export-on-exit .emulator-data",
    "seed": "tsx scripts/seed-emulator.ts",
    "dev:all": "npm run build:functions && concurrently -k -n fn,emu,seed,web -c yellow,blue,green,magenta \"npm --prefix functions run watch\" \"firebase emulators:start --project demo-club-quiz\" \"wait-on -t 120000 tcp:127.0.0.1:9099 tcp:127.0.0.1:8080 tcp:127.0.0.1:9000 tcp:127.0.0.1:5001 && npm run seed\" \"vite\"",
    "add-host": "tsx scripts/add-host.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  }
}
