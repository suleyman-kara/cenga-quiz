# Production config. `npm run configure` writes these to .env.production.local (see docs/firebase-kurulum.md).
# A production build with any of these missing shows a "configuration missing" screen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key). Leave empty to run without App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Dev only: App Check debug token (Firebase Console → App Check → Manage debug tokens). Ignored in production builds.
VITE_APP_CHECK_DEBUG_TOKEN=

# VITE_USE_EMULATORS is DEV-ONLY and lives in .env.development (committed).
# It is ignored by production builds, which never connect to emulators.
